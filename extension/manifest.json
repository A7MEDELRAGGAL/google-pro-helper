{
  "manifest_version": 3,
  "name": "Free Zoot · أداة تفعيل Google AI Pro لمدة سنتين مجاناً",
  "version": "1.0.0",
  "description": "أداة حقن عروض Google One / AI Pro المجانية - حقوق النشر محفوظة لقناة Free Zoot (@Free_Zoot_Dis)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://one.google.com/*",
    "https://tokenized.play.google.com/*",
    "https://play.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "أداة تفعيل Google AI Pro · Free Zoot"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://one.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://one.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://tokenized.play.google.com/*"],
      "js": ["play_guard.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
